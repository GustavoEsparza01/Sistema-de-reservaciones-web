# Copia este archivo como .env y llena los valores de tu proyecto:
# Supabase → Project Settings → API
#
# Usa SOLO la clave "anon" (pública). NUNCA pongas aquí la clave "service_role":
# ignora todas las reglas de seguridad de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon
